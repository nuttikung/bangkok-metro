{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "useTabs": true,
  "sortPackageJson": false,
  "ignorePatterns": ["bun.lock", "dist/**", "dist-ssr/**"],
  "overrides": [
    {
      "files": ["*.json", "*.jsonc", "*.yml", "*.yaml", "*.md"],
      "options": { "useTabs": false }
    }
  ]
}
